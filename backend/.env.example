PORT=3000
NODE_ENV=development

# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# openssl rand -hex 32 などで生成した 32 バイト以上のランダム文字列を推奨
JWT_SECRET=replace_me_with_a_long_random_string

# フロントエンド URL (CORS allow-origin & コールバック後のリダイレクト先)
FRONTEND_URL=http://localhost:5173

# Cookie 設定 (本番 HTTPS 下では COOKIE_SECURE=true 推奨)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# SQLite のファイルパス
DB_PATH=./data.sqlite
